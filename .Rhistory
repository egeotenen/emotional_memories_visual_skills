group_by(Emotion_Condition) %>%
summarise(
n = n(),
mean_valence = mean(Valence_Check, na.rm = TRUE),
median_valence = median(Valence_Check, na.rm = TRUE),
sd_valence = sd(Valence_Check, na.rm = TRUE),
